<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>F# Analyzers for Frank web framework - detects common issues at compile-time</Description>
    <PackageTags>fsharp;analyzer;frank;web</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DuplicateHandlerAnalyzer.fs" />
    <Compile Include="UndereferenceableVocabAnalyzer.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NU1608 suppressed in Directory.Build.props: FSharp.Analyzers.SDK 0.35.0 requests
         FSharp.Core=10.0.101 but Frank.Semantic requires >=10.1.301 on net10.0;
         runtime compatibility is maintained — pin removed to unblock restore. -->
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.35.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Frank.Semantic/Frank.Semantic.fsproj" />
  </ItemGroup>

</Project>
