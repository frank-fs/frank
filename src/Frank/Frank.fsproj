<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ETag.fs" />
    <Compile Include="ETagCache.fs" />
    <Compile Include="ConditionalRequestMiddleware.fs" />
    <Compile Include="AcceptNegotiation.fs" />
    <Compile Include="ProblemJson.fs" />
    <Compile Include="RequestBodyBuffer.fs" />
    <Compile Include="ContentNegotiation.fs" />
    <Compile Include="ClrTypeName.fs" />
    <Compile Include="UriResolution.fs" />
    <Compile Include="OriginValidation.fs" />
    <Compile Include="GeneratedModuleReflection.fs" />
    <Compile Include="Builder.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- GeneratedModuleReflection is codegen/interop plumbing (#392): internal, visible only
       to the four generated-module resolvers that genuinely consume it cross-assembly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Discovery</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.LinkedData</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Validation</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Provenance</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ResourceEndpointDataSource's constructor is internal (#411 narrowed post-review):
       only WebHostBuilder.Run constructs one in production. These two test assemblies
       deliberately mirror that exact production wiring to test it directly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Discovery.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Provenance.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
