<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DiscoveryTypes.fs" />
    <Compile Include="AlpsSerializer.fs" />
    <Compile Include="JsonHomeSerializer.fs" />
    <Compile Include="DiscoveryMiddleware.fs" />
    <Compile Include="GeneratedDiscoveryResolver.fs" />
    <Compile Include="Frank.Discovery.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- #400: document GENERATION only (never MapOpenApi()) — the shared, single source
         for HTTP-method correlation when an app also references Frank.OpenApi. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.0 transitively pulls Microsoft.OpenApi 2.0.0
         (NU1903 known-vulnerability); pin the same fixed version Frank.OpenApi already
         uses (#383). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Frank/Frank.fsproj" />
  </ItemGroup>

  <!-- AlpsSerializer / JsonHomeSerializer / GeneratedDiscoveryResolver are codegen/interop
       plumbing (#392): internal, visible only to Frank.Discovery.Tests and (AlpsSerializer
       only) Frank.Cli.Core.Tests, which exercises the serializer directly against emitter
       output (the existing Frank.Cli.Core pattern, generalized to a second consumer). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Discovery.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Cli.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
