<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageTags>rdf;linked-data;json-ld;triples</PackageTags>
    <Description>Hand-authored RDF triples for Frank resources, serialized as JSON-LD</Description>
    <NoWarn>NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RdfTypes.fsi" />
    <Compile Include="RdfTypes.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Rdf.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
