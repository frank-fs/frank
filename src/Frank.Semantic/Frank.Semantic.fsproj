<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageTags>semantic;vocabulary;linked-data;rdf</PackageTags>
    <Description>Vocabulary CE and registry types for Frank semantic discovery</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProvOClass.fs" />
    <Compile Include="VocabularyRegistry.fs" />
    <Compile Include="VocabularyBuilder.fs" />
    <Compile Include="Mapping.fs" />
    <Compile Include="Hashing.fs" />
    <Compile Include="LockFile.fs" />
    <Compile Include="VocabCheck.fs" />
    <Compile Include="ResolvedModel.fs" />
    <Compile Include="OntologyTypes.fs" />
    <Compile Include="ShapeTypes.fs" />
    <Compile Include="ConventionEngine.fs" />
    <Compile Include="VocabFetcher.fs" />
    <Compile Include="RdfSerialization.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" Version="3.5.1" />
    <!-- dotNetRdf.Core 3.5.1 floats a transitive AngleSharp >= 1.4.0 dependency; NuGet
         resolves the lowest satisfying version (1.4.0), which now trips a live audit
         advisory (GHSA-pgww-w46g-26qg, patched in 1.5.0) as a build error under this
         repo's TreatWarningsAsErrors=true. Pin explicitly to the latest patched stable
         release so every consumer of Frank.Semantic (and transitively Frank.LinkedData,
         Frank.Validation, Frank.Provenance) resolves a non-vulnerable AngleSharp. -->
    <PackageReference Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

</Project>
