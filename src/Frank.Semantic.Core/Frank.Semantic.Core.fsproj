<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageTags>semantic;vocabulary;linked-data</PackageTags>
    <Description>Lock types and vocabulary classification for Frank semantic discovery — no dotNetRdf, no FCS. LockFile.read/write perform file I/O; all other members are pure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Mapping.fs" />
    <Compile Include="Hashing.fs" />
    <Compile Include="LockFile.fs" />
    <Compile Include="VocabClassifier.fs" />
  </ItemGroup>

  <!-- Pin FSharp.Core to the version fsharp-analyzers 0.35.0 loads (10.0.101 / assembly 10.0.0.0).
       Without this pin, the .NET 10 SDK implicit reference resolves 10.1.301 (assembly 10.1.0.0),
       causing the CLI to reject the analyzer DLL with "expected assembly version 10.0.0.0". -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Update="FSharp.Core" Version="10.0.101" />
  </ItemGroup>

</Project>
