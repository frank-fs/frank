<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageTags>validation;shacl;rdf;shapes</PackageTags>
    <Description>SHACL validation interpreter for Frank shape declarations</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ValidationTypes.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="Validator.fs" />
    <Compile Include="JsonLdLoader.fs" />
    <Compile Include="GeneratedValidationResolver.fs" />
    <Compile Include="ValidationMiddleware.fs" />
    <Compile Include="Frank.Validation.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Frank/Frank.fsproj" />
    <ProjectReference Include="../Frank.Semantic/Frank.Semantic.fsproj" />
    <ProjectReference Include="../Frank.Semantic.Core/Frank.Semantic.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" Version="3.5.1" />
    <PackageReference Include="dotNetRdf.Shacl" Version="3.5.1" />
  </ItemGroup>

  <!-- GeneratedValidationResolver is codegen/interop plumbing (#392): internal, visible
       only to Frank.Validation.Tests (the existing Frank.Cli.Core pattern). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Frank.Validation.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
