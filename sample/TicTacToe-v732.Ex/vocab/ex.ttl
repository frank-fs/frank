@prefix ex:   <ex#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

ex:Game a owl:Class ;
    rdfs:label "TicTacToe game" .

ex:MoveAction a owl:Class ;
    rdfs:label "TicTacToe move action" .

ex:ActionStatusType a owl:Class ;
    rdfs:label "TicTacToe action status type" .

ex:ActiveActionStatus a ex:ActionStatusType ;
    rdfs:label "Active action status" .

ex:CompletedActionStatus a ex:ActionStatusType ;
    rdfs:label "Completed action status" .

ex:FailedActionStatus a ex:ActionStatusType ;
    rdfs:label "Failed action status" .

ex:agent a rdf:Property ;
    rdfs:label "game agent (player)" .

ex:cell a rdf:Property ;
    rdfs:label "target board cell of a move" .

ex:identifier a rdf:Property ;
    rdfs:label "game identifier" .

ex:result a rdf:Property ;
    rdfs:label "game result" .

ex:ItemList a owl:Class ;
    rdfs:label "list of game moves" .

ex:item a rdf:Property ;
    rdfs:label "item in a list" .

ex:numberOfItems a rdf:Property ;
    rdfs:label "number of items in a list" .
