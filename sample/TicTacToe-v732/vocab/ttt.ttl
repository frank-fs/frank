@prefix ttt:    <tictactoe#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .

ttt:Square a owl:Class ;
    rdfs:label "Tic-tac-toe board cell" .

ttt:square a rdf:Property ;
    rdfs:domain schema:MoveAction ;
    rdfs:range ttt:Square ;
    rdfs:label "target board square of a move" .

ttt:TopLeft      a ttt:Square ; rdfs:label "Top left" .
ttt:TopCenter    a ttt:Square ; rdfs:label "Top center" .
ttt:TopRight     a ttt:Square ; rdfs:label "Top right" .
ttt:MiddleLeft   a ttt:Square ; rdfs:label "Middle left" .
ttt:MiddleCenter a ttt:Square ; rdfs:label "Middle center" .
ttt:MiddleRight  a ttt:Square ; rdfs:label "Middle right" .
ttt:BottomLeft   a ttt:Square ; rdfs:label "Bottom left" .
ttt:BottomCenter a ttt:Square ; rdfs:label "Bottom center" .
ttt:BottomRight  a ttt:Square ; rdfs:label "Bottom right" .
