<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TestEndpointDataSource.fs" Link="TestEndpointDataSource.fs" />
    <Compile Include="TestHelpers.fs" />
    <Compile Include="SerializerTests.fs" />
    <Compile Include="MiddlewareTests.fs" />
    <Compile Include="AlpsMemoizationTests.fs" />
    <Compile Include="AlpsTypeReconciliationTests.fs" />
    <Compile Include="OpenApiCorrelationTests.fs" />
    <Compile Include="RelationTests.fs" />
    <Compile Include="ResolverTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="OpenApiIntegrationTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Expecto" Version="10.2.3" />
    <PackageReference Include="Expecto.FsCheck" Version="10.2.3" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.14.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Frank.Discovery/Frank.Discovery.fsproj" />
    <!-- #400 AC1: proves Frank.Discovery + Frank.OpenApi coexist on ONE shared
         correlation source when an app references both. -->
    <ProjectReference Include="../../src/Frank.OpenApi/Frank.OpenApi.fsproj" />
  </ItemGroup>

</Project>
