<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ETagTests.fs" />
    <Compile Include="BoundedCacheTests.fs" />
    <Compile Include="MiddlewareOrderingTests.fs" />
    <Compile Include="MetadataTests.fs" />
    <Compile Include="ETagCacheTests.fs" />
    <Compile Include="ConditionalRequestTests.fs" />
    <Compile Include="ConditionalRequestIntegrationTests.fs" />
    <Compile Include="ConditionalRequestContextComputeTests.fs" />
    <Compile Include="HeadRegistrationIntegrationTests.fs" />
    <Compile Include="NameInferenceTests.fs" />
    <Compile Include="PlumbingHiddenTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Expecto" Version="10.2.3" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.14.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Frank/Frank.fsproj" />
    <ProjectReference Include="../../src/Frank.Semantic/Frank.Semantic.fsproj" />
    <ProjectReference Include="../../src/Frank.Discovery/Frank.Discovery.fsproj" />
    <ProjectReference Include="../../src/Frank.Validation/Frank.Validation.fsproj" />
    <ProjectReference Include="../../src/Frank.LinkedData/Frank.LinkedData.fsproj" />
    <ProjectReference Include="../../src/Frank.Provenance/Frank.Provenance.fsproj" />
  </ItemGroup>

</Project>
